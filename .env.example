# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Twilio — https://console.twilio.com (WhatsApp sandbox: Messaging > Try it out > Send a WhatsApp message)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Your own phone, E.164 format
ALLOWED_WHATSAPP_NUMBER=whatsapp:+447700900000

# X — https://developer.x.com/en/portal/dashboard  (app must have Read+Write, OAuth 1.0a user tokens)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Apify — https://console.apify.com/settings/integrations (fetches Instagram posts)
APIFY_TOKEN=

# Appended to every post. Leave empty to disable.
SIGN_OFF=If this kind of thing interests you, follow for more.
